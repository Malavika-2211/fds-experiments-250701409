        "# EXP NO. 11\n",
        "# UNDERSTANDING DATA FRAME USING PANDAS\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1. CREATING A DATAFRAME\n",
        "\n",
        "DATA = {\n",
        "    'NAME': ['ARUN', 'BALAJI', 'CHARAN', 'DIVYA', 'ELIZABETH'],\n",
        "    'AGE': [20, 21, 19, 22, 20],\n",
        "    'MARKS': [85, 90, 78, 92, 88],\n",
        "    'CITY': ['CHENNAI', 'BANGALORE', 'CHENNAI', 'HYDERABAD', 'MUMBAI']\n",
        "}\n",
        "\n",
        "DF = pd.DataFrame(DATA)\n",
        "\n",
        "print(\"DATAFRAME:\")\n",
        "print(DF)\n",
        "\n",
        "# 2. DISPLAY FIRST FIVE ROWS\n",
        "\n",
        "print(\"\\nFIRST FIVE ROWS:\")\n",
        "print(DF.head())\n",
        "\n",
        "# 3. DISPLAY LAST FIVE ROWS\n",
        "\n",
        "print(\"\\nLAST FIVE ROWS:\")\n",
        "print(DF.tail())\n",
        "\n",
        "# 4. DISPLAY DATAFRAME INFORMATION\n",
        "\n",
        "print(\"\\nDATAFRAME INFORMATION:\")\n",
        "print(DF.info())\n",
        "\n",
        "# 5. DISPLAY STATISTICAL SUMMARY\n",
        "\n",
        "print(\"\\nSTATISTICAL SUMMARY:\")\n",
        "print(DF.describe())\n",
        "\n",
        "# 6. SELECTING A COLUMN\n",
        "\n",
        "print(\"\\nNAME COLUMN:\")\n",
        "print(DF['NAME'])\n",
        "\n",
        "print(\"\\nMARKS COLUMN:\")\n",
        "print(DF['MARKS'])\n",
        "\n",
        "# 7. SELECTING MULTIPLE COLUMNS\n",
        "\n",
        "print(\"\\nNAME AND MARKS:\")\n",
        "print(DF[['NAME', 'MARKS']])\n",
        "\n",
        "\n",
        "# 8. FILTERING DATA\n",
        "\n",
        "print(\"\\nSTUDENTS WITH MARKS GREATER THAN 85:\")\n",
        "print(DF[DF['MARKS'] > 85])\n",
        "\n",
        "# 9. SORTING DATA\n",
        "\n",
        "print(\"\\nDATA SORTED BY MARKS:\")\n",
        "print(DF.sort_values('MARKS'))\n",
        "\n",
        "print(\"\\nDATA SORTED BY AGE:\")\n",
        "print(DF.sort_values('AGE', ascending=False))\n",
        "\n",
        "# 10. ADDING A NEW COLUMN\n",
        "\n",
        "DF['RESULT'] = ['PASS', 'PASS', 'PASS', 'PASS', 'PASS']\n",
        "\n",
        "print(\"\\nDATAFRAME AFTER ADDING RESULT:\")\n",
        "print(DF)\n",
        "\n",
        "# 11. CALCULATING AVERAGE MARKS\n",
        "\n",
        "AVERAGE_MARKS = DF['MARKS'].mean()\n",
        "\n",
        "print(\"\\nAVERAGE MARKS:\", AVERAGE_MARKS)\n",
        "\n",
        "# 12. FINDING MAXIMUM AND MINIMUM MARKS\n",
        "\n",
        "print(\"\\nMAXIMUM MARKS:\", DF['MARKS'].max())\n",
        "print(\"MINIMUM MARKS:\", DF['MARKS'].min())\n",
        "\n",
        "# 13. CHECKING MISSING VALUES\n",
        "\n",
        "print(\"\\nMISSING VALUES:\")\n",
        "print(DF.isnull().sum())\n",
        "\n",
        "# 14. GROUPING DATA\n",
        "\n",
        "print(\"\\nAVERAGE MARKS BY CITY:\")\n",
        "print(DF.groupby('CITY')['MARKS'].mean())\n",
        "\n",
        "\n",
        "# 15. RESETTING INDEX\n",
        "\n",
        "DF = DF.reset_index(drop=True)\n",
        "\n",
        "print(\"\\nFINAL DATAFRAME:\")\n",
        "print(DF)"
